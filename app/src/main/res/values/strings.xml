    <string name="tour_intro_title">Bienvenida a Up Dice</string>
    <string name="tour_intro_body">Te llevo por la app señalando cada botón y lo que hace. Puedes tocar lo resaltado para probarlo, o usar Siguiente.</string>
    <string name="tour_theme_title">Tema claro u oscuro</string>
    <string name="tour_theme_body">Este interruptor cambia entre el tema claro y el oscuro en toda la app.</string>
    <string name="tour_name_title">Tu nombre</string>
    <string name="tour_name_body">Escríbelo aquí y la app te saluda por tu nombre. Se guarda en tu teléfono.</string>
    <string name="tour_progress_title">Logros</string>
    <string name="tour_progress_body">El trofeo abre tus logros, tus récords y tu racha de victorias.</string>
    <string name="tour_settings_title">Ajustes</string>
    <string name="tour_settings_body">Aquí eliges cuántos dados y de cuántas caras, su color y tamaño, la dificultad, jugar con amigos, el sonido, la vibración y el estilo de la app.</string>
    <string name="tour_play_title">¡A jugar!</string>
    <string name="tour_play_body">Este botón empieza la partida. Tócalo y seguimos dentro del juego.</string>
    <string name="tour_scores_title">Tus puntos</string>
    <string name="tour_scores_body">Para ganar tienes que llegar a la meta de puntos antes de que se acaben los lanzamientos. La barra muestra cuánto llevas.</string>
    <string name="tour_info_title">Datos de la partida</string>
    <string name="tour_info_body">Cuántos dados usas, de cuántas caras y cuántos tiros seguidos llevas. Tócala para cambiarlos en Ajustes.</string>
    <string name="tour_dice_title">Los dados</string>
    <string name="tour_dice_body">Desliza un dado hacia arriba para lanzarlo. También puedes agitar el teléfono. Con varios dados, tócalos para bloquearlos.</string>
    <string name="tour_roll_title">Tirar</string>
    <string name="tour_roll_body">Con este botón lanzas los dados. Cada tiro suma puntos, y si sale la cara más alta es un crítico.</string>
    <string name="tour_recent_title">Últimos tiros</string>
    <string name="tour_recent_body">Cada tiro queda dibujado con el dado tal como salió. El enlace Estadísticas muestra cuántas veces ha salido cada cara.</string>
    <string name="tour_sound_title">Sonido</string>
    <string name="tour_sound_body">Silencia o activa el sonido de los dados.</string>
    <string name="tour_reset_title">Reiniciar</string>
    <string name="tour_reset_body">Empieza la partida de cero: borra puntos, lanzamientos e historial. Antes te pregunta si estás segura.</string>
